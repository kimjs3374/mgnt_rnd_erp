[Unit]
Description=6PM notifier — 매일 아침 한 번
Documentation=https://rnd.mgnt.kr

[Timer]
# 출근해서 슬랙을 여는 시각에 맞춘다. 밤에 보내면 아침에 스크롤 위로 밀려 안 읽힌다.
OnCalendar=*-*-* 09:00:00
# 서버가 꺼져 있었으면 켜진 뒤에 한 번 돌린다. 기한 알림은 하루 건너뛰면 의미가 없다.
Persistent=true
# 여러 타이머가 정각에 몰리는 것을 흩는다.
RandomizedDelaySec=120
Unit=rnd-notify.service

[Install]
WantedBy=timers.target
